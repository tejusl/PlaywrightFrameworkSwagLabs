{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["Pages/**/*.ts", "data/**/*.ts", "fixtures/**/*.ts", "test/**/*.ts", "Playwright.config.ts"],
  "exclude": ["node_modules", "playwright-report"]
}
